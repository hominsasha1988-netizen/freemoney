# Обов'язково
BOT_TOKEN=123456:ABC...            # токен від @BotFather (НІКОЛИ не коміть справжній)
ADMIN_IDS=123456789                # Telegram ID адмінів через кому

# Рекомендовано
PUBLIC_URL=https://your-app.onrender.com   # https-адреса сервера (на Render підставляється автоматично)
APP_SHORT_NAME=app                          # short name Mini App з BotFather /newapp

# Необов'язково
# DB_PATH=/var/data/app.db         # шлях до SQLite на постійному диску
# CHANNELS=Crypto_Rabbit3          # канали при першому запуску (далі керуються з адмінки)
# BOT_MODE=auto                    # auto | webhook | polling
# PORT=3000
